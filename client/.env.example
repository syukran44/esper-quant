# Clerk — https://dashboard.clerk.com → API keys → "TanStack Start"
# Tanpa dua variabel ini, Clerk jatuh ke "keyless mode": SDK bikin app sementara
# sendiri dan nyimpen kuncinya di client/.clerk/. Auth-nya jalan, tapi bukan
# app kamu — user, session, dan settings-nya hilang begitu kunci itu dihapus.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
